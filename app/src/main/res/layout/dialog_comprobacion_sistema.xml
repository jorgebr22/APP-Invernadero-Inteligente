<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_greenhouse"
        android:padding="24dp">

        <!-- Icono -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="✅"
            android:textSize="38sp"
            android:layout_marginBottom="8dp" />

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Comprobación del sistema"
            android:textColor="#145A1F"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Sesión -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="#EEF7EE"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sesión de usuario"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/tvComprobacionSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correcta"
                android:textStyle="bold"
                android:textColor="#2E7D32" />

        </LinearLayout>

        <!-- Cuenta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="#EEF7EE"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Estado de la cuenta"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/tvComprobacionCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verificada"
                android:textStyle="bold"
                android:textColor="#2E7D32" />

        </LinearLayout>

        <!-- Sistema -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="#EEF7EE"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Conexión del sistema"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/tvComprobacionConexion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desconectado"
                android:textStyle="bold"
                android:textColor="#C62828" />

        </LinearLayout>

        <!-- Bomba -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="#EEF7EE"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bomba de agua"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/tvComprobacionBomba"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apagada"
                android:textStyle="bold"
                android:textColor="#616161" />

        </LinearLayout>

        <!-- Ventilación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="#EEF7EE"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ventilación"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/tvComprobacionVentilacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apagada"
                android:textStyle="bold"
                android:textColor="#616161" />

        </LinearLayout>

        <Button
            android:id="@+id/btnAceptarComprobacion"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="ACEPTAR"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32" />

    </LinearLayout>

</ScrollView>