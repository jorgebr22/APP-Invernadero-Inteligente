<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_greenhouse"
    android:padding="24dp">

    <!-- Icono -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="🔄"
        android:textSize="40sp"
        android:layout_marginBottom="8dp" />

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Reinicio de sistema"
        android:textColor="#145A1F"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Explicación -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="¿Seguro que deseas reiniciar el sistema?"
        android:textColor="#212121"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Advertencia -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="La bomba de agua y la ventilación volverán a su estado inicial."
        android:textColor="#795548"
        android:textSize="14sp"
        android:background="#FFF3E0"
        android:padding="14dp"
        android:layout_marginBottom="22dp" />

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelarReinicio"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="CANCELAR"
            android:textStyle="bold"
            android:textColor="#424242"
            android:backgroundTint="#E0E0E0" />

        <Button
            android:id="@+id/btnConfirmarReinicio"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="REINICIAR"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#C62828" />

    </LinearLayout>

</LinearLayout>