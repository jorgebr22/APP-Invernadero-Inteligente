<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloMiCuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mi cuenta"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#1B5E20"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Foto de perfil con botón de editar -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/imgPerfil"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/bg_profile_circle"
                android:padding="22dp"
                android:src="@drawable/ic_person_profile"
                android:scaleType="centerInside"
                android:contentDescription="Foto de perfil" />

            <ImageButton
                android:id="@+id/btnEditarFoto"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_edit_foto"
                android:src="@android:drawable/ic_menu_edit"
                android:tint="#FFFFFF"
                android:padding="7dp"
                android:contentDescription="Editar foto de perfil" />
        </FrameLayout>

        <!-- Nombre completo -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre completo"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombrePerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textColor="#212121" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Correo -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Correo electrónico"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCorreoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textColor="#212121" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#EEF7EE"
            android:padding="12dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Estado de la cuenta"
                android:textStyle="bold"
                android:textColor="#212121"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvEstadoCorreoPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Verificado"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelarPerfil"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="CANCELAR"
                android:textStyle="bold"
                android:textColor="#424242"
                android:backgroundTint="#E0E0E0" />

            <Button
                android:id="@+id/btnGuardarPerfil"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="GUARDAR"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E7D32" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>