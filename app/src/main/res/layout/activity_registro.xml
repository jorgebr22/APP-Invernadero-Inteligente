<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_login"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="32dp"
            android:paddingTop="24dp"
            android:paddingEnd="32dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌱"
                android:textSize="54sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crear cuenta"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#145A1F"
                android:gravity="center"
                android:layout_marginBottom="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Regístrate en GreenHouse"
                android:textSize="15sp"
                android:textColor="#333333"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <!-- NOMBRE -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Nombre"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#F2FFFFFF"
                app:boxStrokeColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="textPersonName|textCapWords"
                    android:autofillHints="name"
                    android:textColor="#212121" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- APELLIDO PATERNO -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Apellido paterno"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#F2FFFFFF"
                app:boxStrokeColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApellidoPaterno"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="#212121" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- APELLIDO MATERNO -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Apellido materno"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#F2FFFFFF"
                app:boxStrokeColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApellidoMaterno"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="#212121" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- CORREO -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Correo electrónico"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#F2FFFFFF"
                app:boxStrokeColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCorreoRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress"
                    android:textColor="#212121" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- CONTRASEÑA -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutContrasenaRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:hint="Contraseña"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#F2FFFFFF"
                app:boxStrokeColor="#2E7D32"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContrasenaRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword"
                    android:textColor="#212121" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mínimo 8 caracteres. Debe incluir mayúscula, minúscula, número y símbolo."
                android:textSize="12sp"
                android:textColor="#424242"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="12dp" />

            <!-- CONFIRMAR CONTRASEÑA -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutConfirmarContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="Confirmar contraseña"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#F2FFFFFF"
                app:boxStrokeColor="#2E7D32"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmarContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword"
                    android:textColor="#212121" />

            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnCrearCuenta"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="CREAR CUENTA"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E7D32" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Ya tienes una cuenta?"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/tvVolverLogin"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="140dp"
                android:gravity="center"
                android:text="INICIAR SESIÓN"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#145A1F"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistema de control IoT"
                android:textSize="13sp"
                android:textColor="#424242"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>